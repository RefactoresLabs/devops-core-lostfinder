types {

    text/html                             html htm shtml;
    text/css                              css;
    text/xml                              xml;
    image/gif                             gif;
    image/jpeg                            jpeg jpg;
    image/png                             png;
    image/svg+xml                         svg svgz;
    image/webp                            webp;
    image/x-icon                          ico;

    application/javascript                js mjs;
    application/json                      json map;
    application/xml                       rdf rss atom;
    application/pdf                       pdf;

    font/woff                             woff;
    font/woff2                            woff2;
    application/vnd.ms-fontobject         eot;
    font/ttf                              ttf;
    font/otf                              otf;

    video/mp4                             mp4;
    video/webm                            webm;

    audio/mpeg                            mp3;
    audio/ogg                             ogg;

    application/zip                       zip;
    application/gzip                      gz tar tgz;

    text/plain                            txt log;

    application/octet-stream              bin exe dll;
}